# Copia este archivo a .env (está en .gitignore) y completa los valores.
# NUNCA subas .env al repositorio.

# API key de ElevenLabs. Recomendado: crear una key dedicada a este proyecto,
# con permisos mínimos (Agents) y límite de crédito si tu plan lo permite.
ELEVENLABS_API_KEY=

# ID del agente Danny (pestaña del agente en el panel de ElevenLabs).
ELEVENLABS_AGENT_ID=

# Opcional: región/endpoint. Comparar latencia con https://api.us.elevenlabs.io
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Opcional: precio supuesto por minuto para la estimación de costo (US$).
# ELEVENLABS_COST_PER_MIN=0.08
