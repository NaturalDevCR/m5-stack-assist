# Secretos del puente. Copiar a /etc/danny-bridge/danny-bridge.env (permisos 600).
# NUNCA subir este archivo con valores reales al repositorio.

# Clave de ElevenLabs con permiso "ElevenAgents: Escribir".
ELEVENLABS_API_KEY=

# Token que deben presentar los terminales (AtomS3R). Generar con: openssl rand -hex 24
DANNY_TERMINAL_TOKEN=

# Contraseña del usuario MQTT (mqtt.username en config.yaml).
MQTT_PASSWORD=
